# ==============================================================
# LearnSphere AI - Master Environment Configuration Template
# Copy this file to backend/.env and frontend/.env respectively
# ==============================================================

# ----------------- BACKEND CONFIGURATION (.env) -----------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Firebase Admin SDK Configuration
# Option A: Path to service account JSON file (relative to backend/ or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
# Option B: Raw JSON string or base64 encoded string for cloud deployment (e.g. Render)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Storage Mode (local | firebase)
STORAGE_MODE=local
UPLOAD_DIR=uploads

# JWT / Session Secrets (Optional additional backend token security)
JWT_SECRET=learnsphere_dev_secret_change_in_production

# ----------------- FRONTEND CONFIGURATION (.env) ----------------
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
